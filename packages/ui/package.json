{
  "name": "@nexus/ui",
  "version": "0.0.1",
  "description": "Nexus Design System component library",
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{ recursive: true, force: true })\"",
    "build": "vite build",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"test/**/*.{ts,tsx}\"",
    "lint:fix": "pnpm run lint -- --fix",
    "typecheck": "tsc -p tsconfig.json",
    "build:types": "pnpm run clean && tsc -p tsconfig.build.json",
    "build:dist": "pnpm run clean && vite build && tsc -p tsconfig.build.json",
    "test": "vitest",
    "ctest": "vitest --coverage"
  },
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/nexus-ui.umd.cjs",
  "module": "./dist/nexus-ui.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/nexus-ui.js",
      "require": "./dist/nexus-ui.umd.cjs",
      "types": "./dist/index.d.ts"
    },
    "./styles.css": "./dist/nexus-ui.css"
  },
  "devDependencies": {
    "@storybook/react-vite": "^10.3.6",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@vanilla-extract/vite-plugin": "^5.2.2",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/ui": "^4.1.9",
    "jsdom": "^29.1.1",
    "react": "^19.2.6",
    "vite": "^8.0.11",
    "vitest": "^4.1.5"
  },
  "peerDependencies": {
    "react": "^19.2.6"
  },
  "dependencies": {
    "@nexus/tokens": "workspace:*",
    "@vanilla-extract/css": "^1.20.1",
    "@vanilla-extract/sprinkles": "^1.6.5",
    "lucide-react": "^1.20.0"
  }
}

{
  "name": "@nexus/ui",
  "version": "0.0.1",
  "description": "Nexus Design System component library",
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "build:types": "tsc -p tsconfig.json",
    "build:dist": "vite build && tsc -p tsconfig.json"
  },
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/nexus-ui.umd.cjs",
  "module": "./dist/nexus-ui.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/nexus-ui.js",
      "require": "./dist/nexus-ui.umd.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@vitejs/plugin-react": "^6.0.1",
    "react": "^19.2.6",
    "typescript": "^6.0.3",
    "vite": "^8.0.11"
  },
  "peerDependencies": {
    "react": "^19.2.6"
  }
}

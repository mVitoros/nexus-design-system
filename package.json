  "main": "index.js",
  "scripts": {
    "test": "pnpm --filter @nexus/ui run test",
    "ctest": "pnpm --filter @nexus/ui run ctest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:ui": "pnpm --filter @nexus/ui run lint",
    "lint:tokens": "pnpm --filter @nexus/tokens run lint",
    "lint:storybook": "pnpm --filter @nexus/storybook run lint",
    "storybook": "pnpm --filter @nexus/storybook run storybook",
    "build:ui": "pnpm --filter @nexus/ui run build:dist",
    "build:tokens": "pnpm --filter @nexus/tokens run build:dist",
    "build:storybook": "pnpm --filter @nexus/storybook run build:storybook",
    "tsc": "pnpm --filter @nexus/storybook run typecheck && pnpm --filter @nexus/tokens run typecheck && pnpm --filter @nexus/ui run typecheck",
    "tsc:storybook": "pnpm --filter @nexus/storybook run typecheck",
    "tsc:ui": "pnpm --filter @nexus/ui run typecheck",
    "tsc:tokens": "pnpm --filter @nexus/tokens run typecheck",
    "build": "pnpm build:tokens && pnpm build:ui && pnpm build:storybook",
    "prepare": "husky"
  },
  "keywords": [],
